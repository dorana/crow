## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
/bin/
/obj/
**/bin/
**/obj/

# Visual Studio cache/options
.vs/

# Rider project files
.idea/
*.sln.iml

# Rider caches
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/dictionaries

# Visual Studio Code
.vscode/

# NuGet
*.nupkg
/packages/
project.lock.json
project.assets.json
.nuget/

# Dotnet publish
/publish/

# Logs
*.log
npm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# Test result files
TestResults/
*.trx

# Rider/Resharper
_ReSharper*/
*.DotSettings.user

# Profiling & coverage
*.coverage
*.coveragexml
*.opendb
*.pyc

# Local secrets and environment files (optional - uncomment if desired)
# appsettings.Local.json
# secrets.json

# Others
*.bak
*.swp
